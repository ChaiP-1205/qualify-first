# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=
TAVILY_API_KEY=
# A number (e.g. 40): Tavily searches per day. Fill it in; an empty value stops the app from starting.
TAVILY_DAILY_CAP=
DEMO_CHECKS_PER_DAY=5

# Optional. Uncomment only to override the app's default; an empty value is not the same as unset.
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=
# DRAFT_MODEL=
# MAX_DAILY_ANALYSES=
# USAGE_COUNTER_FILE=
# TAVILY_COUNTER_FILE=
# PORT=
# EXAMPLES_TAVILY_CAP=   (scripts/build_examples.py only)
# Anonymous analytics (PostHog): leave POSTHOG_KEY unset to load no script and send nothing.
# POSTHOG_HOST defaults to https://us.i.posthog.com (https://eu.i.posthog.com for an EU project).
# POSTHOG_KEY=
# POSTHOG_HOST=
